# Copy this file to .env for local infrastructure only. Do not commit .env.
POSTGRES_DB=familyhealthllm
POSTGRES_USER=familyhealthllm
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
NEO4J_AUTH=neo4j/replace-with-a-long-random-local-password
QDRANT_API_KEY=replace-with-a-long-random-local-key

# Free, local LLM runtime. Install Ollama separately and pull the named model locally.
# The mobile app never receives this URL or any model credential.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60

# Development only. A public launch requires authentication and per-household authorization.
FAMILY_HEALTH_LLM_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:8081
